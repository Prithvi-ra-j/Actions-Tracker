# Browser-safe Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recommended production AI path: set this to the deployed same-origin gateway.
VITE_AI_GATEWAY_URL=/api/jarvis

# Server-only provider configuration for Vercel/serverless.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=30000
