+/** Keeps only the newest MAX_DATED_BACKUPS dated backups. Never throws. */
+async function pruneOldBackups() {
+  try {
+    const listing = await Filesystem.readdir({ path: '', directory: Directory.Documents });
+    const dated = (listing.files || [])
+      .map(file => file.name)
+      .filter(name => /^ActionsTracker_Backup_\d{4}-\d{2}-\d{2}\.json$/.test(name))
+      .sort()
+      .reverse();
+    for (const name of dated.slice(MAX_DATED_BACKUPS)) {
+      await Filesystem.deleteFile({ path: name, directory: Directory.Documents }).catch(() => {});
+    }
+  } catch {
+    // Pruning is best-effort.
+  }
+}
